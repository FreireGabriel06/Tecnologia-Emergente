# Normaliza finais de linha de arquivos de texto
* text=auto

# Código
*.cs     text diff=csharp
*.shader text
*.hlsl   text
*.cginc  text
*.json   text
*.md     text

# Arquivos YAML do Unity (cenas, prefabs, materiais...). "unityyamlmerge" só é usado
# se alguém configurar o Smart Merge do Unity; sem isso o Git faz o merge normal.
*.unity          text merge=unityyamlmerge eol=lf
*.prefab         text merge=unityyamlmerge eol=lf
*.mat            text merge=unityyamlmerge eol=lf
*.anim           text merge=unityyamlmerge eol=lf
*.controller     text merge=unityyamlmerge eol=lf
*.meta           text merge=unityyamlmerge eol=lf
*.physicMaterial text merge=unityyamlmerge eol=lf
*.inputactions   text eol=lf
# .asset pode ser texto ou binário (ex.: LightingData.asset), então o Git detecta sozinho.
*.asset          merge=unityyamlmerge
LightingData.asset binary

# ---------------------------------------------------------------
# Arquivos grandes vão para o Git LFS (o GitHub recusa arquivos > 100 MB).
# Cada pessoa precisa rodar "git lfs install" UMA vez no computador
# (o Git for Windows e o GitHub Desktop já trazem o LFS).
# ---------------------------------------------------------------
# Modelos 3D
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
*.max   filter=lfs diff=lfs merge=lfs -text
*.skp   filter=lfs diff=lfs merge=lfs -text

# Imagens e texturas
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text

# Vídeo e áudio
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text

# Fontes
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Documentos binários
*.docx binary
*.pdf  binary

# O cenário do Sebraelab é pequeno (~11 MB) e fica no Git normal, sem LFS:
# assim funciona mesmo para quem ainda não instalou o Git LFS.
Assets/Sebraelab3D/** -filter -diff -merge -text

# O vídeo de apresentação (~16 MB) também fica no Git normal.
Docs/Apresentacao/*.mp4 -filter -diff -merge -text
